// Prisma schema for Jarvis — a shared scheduling assistant for small groups.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A person who can sign in to the web app (access control). Distinct from
/// Member, which is a participant in a circle's schedule.
model AuthUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  googleSub String?  @unique
  /// 'admin' | 'member'
  role      String   @default("member")
  /// Encrypted WhatsApp number (for admin direct chat) + blind index.
  waEnc     String?
  waHash    String?  @unique
  /// Telegram user id (set when the admin links their Telegram via deep link).
  tgId          String?   @unique
  /// Short-lived code to link this admin's Telegram account (t.me ?start=).
  tgLinkCode    String?   @unique
  tgLinkExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Circles this user is a (per-circle) admin of.
  circleAdminOf CircleAdmin[]
  /// OAuth account-linking (e.g. Alexa) issued to this user.
  oauthAuthCodes OAuthAuthCode[]
  oauthTokens    OAuthToken[]
  /// Active break-glass grants this user holds over circles.
  supportGrants  CircleSupportGrant[]
}

/// Grants an AuthUser admin rights over a single circle (manage its members,
/// groups, WhatsApp, email, jobs, cover) — but NOT site-wide Permissions.
model CircleAdmin {
  circleId   String
  authUserId String
  circle     Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user       AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([circleId, authUserId])
  @@index([authUserId])
}

/// The top-level tenant: a family / friend group, bound to its own dedicated
/// Jarvis WhatsApp number. Everything below is isolated per circle.
model Circle {
  id       String @id @default(cuid())
  name     String
  /// Default IANA time zone for this circle.
  timezone String @default("UTC")
  /// The linked Jarvis WhatsApp number (display only; auth state on disk).
  waSelf   String?
  /// Card background image — an uploaded data URL (admin-managed).
  coverImageUrl String? @db.LongText

  /// Dedicated mailbox (IMAP) the email-poll maintenance job reads.
  emailAddress       String?  @unique
  emailEncCred       String?  @db.Text
  emailHost          String?
  emailPort          Int?
  emailEnabled       Boolean  @default(false)
  emailFirstScanDone Boolean  @default(false)
  emailLastUid       Int?
  emailLastPolledAt  DateTime?

  /// Soft-delete: when set, the circle is scheduled for deletion (data retained).
  deletedAt  DateTime?
  /// When the worker will hard-delete the circle and all its data.
  purgeAfter DateTime?

  /// Per-circle LLM spend caps (USD, estimated). Enforced before each agent call.
  dailyUsdLimit   Float @default(1)
  monthlyUsdLimit Float @default(25)

  /// Short-lived code to link a Telegram group to this circle (/link <code>).
  tgLinkCode    String?   @unique
  tgLinkExpires DateTime?

  /// Scrypt hash (salt:hash) of the support passphrase a circle insider sets so a
  /// site admin can unlock time-limited access to this circle's data. Null = unset.
  supportPassphraseHash String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups        Group[]
  members       Member[]
  events        Event[]
  vacations     Vacation[]
  proposals     EmailProposal[]
  conversations Conversation[]
  mutedJobs     CircleMutedJob[]
  admins        CircleAdmin[]
  emailPolls    EmailPollLog[]
  maintRuns     MaintenanceRun[]
  llmUsage      LlmUsage[]
  supportGrants CircleSupportGrant[]

  @@index([purgeAfter])
}

/// A time-limited "break-glass" grant letting a site admin (authUser) access a
/// circle's data after entering its support passphrase. Auto-expires.
model CircleSupportGrant {
  id         String   @id @default(cuid())
  circleId   String
  circle     Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  authUserId String
  authUser   AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([circleId, authUserId])
  @@index([authUserId, expiresAt])
}

/// A WhatsApp group the circle's Jarvis number is in. Has a shared calendar.
model Group {
  id              String @id @default(cuid())
  circleId        String
  circle          Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  name            String
  /// The WhatsApp group id (jid).
  whatsappGroupId String? @unique
  /// The Telegram group chat id (alternative transport to WhatsApp).
  telegramChatId  String? @unique
  inviteLink      String?
  /// Secret token for the read-only iCal subscription feed.
  icalToken       String  @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       GroupMember[]
  events        Event[]
  conversations Conversation[]

  @@index([circleId])
  @@index([whatsappGroupId])
}

/// A person in a circle. The same human in two circles is two Members.
model Member {
  id       String @id @default(cuid())
  circleId String
  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  name  String?
  /// Encrypted WhatsApp number (AES-256-GCM, base64).
  waEnc  String? @db.Text
  /// Blind index (HMAC) of the WhatsApp number, for equality lookups.
  waHash String?
  /// Telegram user id (numeric, stored as string). Not a phone — stored plain.
  tgId   String?
  /// Personal email; links a Google web login to this member.
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups         GroupMember[]
  createdEvents  Event[] @relation("EventCreator")
  assignedEvents Event[] @relation("EventAssignee")
  /// Private events this member owns (their individual schedule).
  ownedEvents    Event[] @relation("EventOwner")
  conversations  Conversation[]
  /// Trips this member is travelling on (implicit m2m -> _VacationTravelers).
  vacations      Vacation[] @relation("VacationTravelers")

  @@index([circleId])
  @@index([waHash])
  @@index([circleId, tgId])
  @@index([email])
}

/// Which members belong to which WhatsApp group (within a circle).
model GroupMember {
  groupId  String
  memberId String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([groupId, memberId])
  @@index([memberId])
}

/// A scheduled item. Times stored in UTC. `circleId` is the isolation key.
/// A SHARED group event has `groupId` set; a PRIVATE individual event has
/// `groupId` null and `ownerMemberId` set.
model Event {
  id       String @id @default(cuid())
  circleId String
  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  groupId  String?
  group    Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Owner of a private event (groupId null). Null for shared group events.
  ownerMemberId String?
  owner         Member? @relation("EventOwner", fields: [ownerMemberId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean   @default(false)
  location    String?
  /// "reminder" = simple non-blocking nudge; "event" = a hard time block.
  kind        String    @default("reminder")
  /// For events: minutes before `startsAt` to send the reminder (null = at start).
  reminderLeadMinutes Int?
  /// appointment | vacation | reminder | other
  category    String?
  /// Optional hex color; falls back to the category color.
  color       String?
  /// RFC 5545 RRULE value (without "RRULE:" prefix). Null for one-off events.
  rrule       String?  @db.Text

  /// Where this event came from: whatsapp | email | web.
  source    String
  sourceRef String?
  rawText   String?  @db.Text

  createdById String?
  createdBy   Member? @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// The individual this event is for (null = whole group).
  assigneeId String?
  assignee   Member? @relation("EventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// When a reminder was last sent for this event.
  remindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId, startsAt])
  @@index([groupId, startsAt])
  @@index([ownerMemberId, startsAt])
  @@index([source, sourceRef])
  @@index([assigneeId])
}

/// A planned trip — one circle-wide vacation calendar. Times stored UTC.
model Vacation {
  id           String  @id @default(cuid())
  circleId     String
  circle       Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  title        String
  destinations String?
  startDate    DateTime
  endDate      DateTime
  /// IANA zone the whole trip displays in. Null = use circle.timezone.
  timezone     String?
  description  String?  @db.Text
  coverImageUrl String? @db.Text
  travelers    Member[] @relation("VacationTravelers")
  items        VacationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId, startDate])
}

/// One itinerary entry within a trip (activity, flight, hotel, …).
model VacationItem {
  id         String   @id @default(cuid())
  vacationId String
  vacation   Vacation @relation(fields: [vacationId], references: [id], onDelete: Cascade)
  /// activity | flight | hotel | transport | meal | note
  type       String   @default("activity")
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  allDay     Boolean  @default(false)
  location   String?
  notes      String?  @db.Text
  confirmation String?
  provider   String?
  number     String?
  fromLabel  String?
  toLabel    String?
  fromTimezone String?
  toTimezone   String?
  seat       String?
  phone      String?
  cost       String?
  color      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vacationId, startsAt])
}

/// A scheduling item detected in a polled email, awaiting confirmation in the
/// owner's DM before it is created. `payload` is JSON used to recreate it.
model EmailProposal {
  id         String   @id @default(cuid())
  circleId   String
  circle     Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  code       String
  /// reminder | event | vacation
  kind       String
  title      String
  summary    String   @db.Text
  payload    String   @db.Text
  fromEmail  String?
  subject    String?
  messageId  String?
  /// pending | confirmed | rejected
  status     String   @default("pending")
  notifiedAt DateTime?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([circleId, status])
  @@index([messageId])
}

/// One row per maintenance job run (daily_brief, health_check, …) — feeds the
/// Maintenance job-run calendar. Email polls live in EmailPollLog and are merged
/// into the same calendar at read time.
model MaintenanceRun {
  id       String   @id @default(cuid())
  /// email_poll | daily_brief | health_check
  job      String
  circleId String?
  circle   Circle?  @relation(fields: [circleId], references: [id], onDelete: SetNull)
  ranAt    DateTime @default(now())
  ok       Boolean  @default(true)
  summary  String?  @db.Text

  @@index([ranAt])
  @@index([job, ranAt])
}

/// One row per mailbox poll run — the activity log shown under Email.
model EmailPollLog {
  id       String   @id @default(cuid())
  circleId String
  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  ranAt    DateTime @default(now())
  /// New messages examined this run.
  scanned  Int      @default(0)
  /// Proposals (items) created this run.
  found    Int      @default(0)
  /// Set when the poll failed (connection/auth error).
  error    String?  @db.Text

  @@index([circleId, ranAt])
}

/// Conversation history for agent context. Scoped to a circle, optionally to a
/// WhatsApp group thread (groupId) or a member's private DM thread (memberId).
model Conversation {
  id       String @id @default(cuid())
  circleId String
  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  groupId  String?
  group    Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// whatsapp | web
  channel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([circleId, channel])
  @@index([groupId])
  @@index([memberId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role       String
  authorName String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([conversationId])
}

/// Per-job, per-circle maintenance mute. Presence = muted.
model CircleMutedJob {
  circleId String
  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  /// 'email_poll' | 'daily_brief' | 'health_check'
  job      String
  createdAt DateTime @default(now())

  @@id([circleId, job])
}

/// An OAuth2 client that links an external account to a Jarvis user — e.g. the
/// Alexa skill (account linking). Created/managed by a site admin.
model OAuthClient {
  id           String   @id @default(cuid())
  /// Public client_id used in the OAuth flow.
  clientId     String   @unique
  /// sha256 hex of the client secret.
  secretHash   String
  name         String
  /// Allowed redirect URIs, comma-separated.
  redirectUris String   @db.Text
  createdAt    DateTime @default(now())

  authCodes OAuthAuthCode[]
  tokens    OAuthToken[]
}

/// Short-lived authorization code for the Auth Code grant (with PKCE).
model OAuthAuthCode {
  id                  String      @id @default(cuid())
  /// sha256 hex of the issued code.
  codeHash            String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authUserId          String
  authUser            AuthUser    @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  redirectUri         String      @db.Text
  /// PKCE code challenge + method (S256).
  codeChallenge       String
  codeChallengeMethod String      @default("S256")
  expiresAt           DateTime
  createdAt           DateTime    @default(now())

  @@index([authUserId])
}

/// One LLM API call's token usage, attributed to a circle (null = a call with no
/// circle context). Powers per-circle billing; cost is computed at query time.
model LlmUsage {
  id       String  @id @default(cuid())
  /// Null for calls made outside any circle (e.g. cover-image extraction).
  circleId String?
  circle   Circle? @relation(fields: [circleId], references: [id], onDelete: SetNull)
  /// Model id, e.g. "claude-opus-4-8".
  model    String
  /// Where the call came from: web | whatsapp | email | alexa | …
  source   String
  inputTokens         Int @default(0)
  outputTokens        Int @default(0)
  cacheReadTokens     Int @default(0)
  cacheCreationTokens Int @default(0)
  createdAt DateTime @default(now())

  @@index([circleId, createdAt])
  @@index([createdAt])
}

/// An issued access + refresh token pair, scoped to one AuthUser. Tokens are
/// stored hashed; the bearer value is shown only once at issue time.
model OAuthToken {
  id               String      @id @default(cuid())
  clientId         String
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authUserId       String
  authUser         AuthUser    @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  /// sha256 hex of the access token.
  accessTokenHash  String      @unique
  /// sha256 hex of the refresh token.
  refreshTokenHash String?     @unique
  expiresAt        DateTime
  createdAt        DateTime    @default(now())

  @@index([authUserId])
}

/// A self-service onboarding application for a brand-new circle. Captured before
/// any AuthUser/Circle exists; an admin reviews and approves it, then the
/// applicant returns (via a signed resume link) to connect WhatsApp + email,
/// at which point the real Circle is provisioned. One row = one sign-up.
model CircleSignup {
  id          String @id @default(cuid())

  /// Step 1 — applicant details.
  name        String
  email       String
  /// What the circle should be called (defaults to "<name>'s circle").
  circleName  String?
  /// Encrypted WhatsApp-enabled phone (AES-256-GCM) + blind index + display mask.
  phoneEnc    String @db.Text
  phoneHash   String
  phoneMask   String

  /// Terms & conditions acceptance — stored for audit (version + timestamp + who).
  termsVersion    String
  termsAcceptedAt DateTime
  termsIp         String?
  termsUserAgent  String? @db.Text

  /// State machine:
  /// pending_review → approved → completed   (or → rejected at review time).
  status      String @default("pending_review")

  /// Opaque token in the admin review email's deep link.
  reviewToken String @unique
  /// Opaque token the applicant uses to resume after approval (emailed to them).
  resumeToken String @unique

  /// Step 4 — the messaging channel the circle will use: 'whatsapp' | 'telegram'.
  /// The other channel can be added later from the admin Connections panel.
  channel      String?
  /// The dedicated WhatsApp number (only when channel = 'whatsapp'). Telegram
  /// links a group via a code after the circle is created, so needs no number.
  waNumber     String?

  /// Step 5 — the circle's dedicated mailbox (IMAP). Credential encrypted at rest.
  emailAddress String?
  emailHost    String?
  emailPort    Int?
  emailEncCred String? @db.Text

  /// Outcome — set once provisioned.
  circleId    String?
  reviewedAt  DateTime?
  reviewedBy  String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}
