// Prisma schema for Jarvis — a shared scheduling assistant for small groups.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A person who can sign in to the web app (access control). Distinct from
/// Member, which is a participant in a group's schedule.
model AuthUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  googleSub String?  @unique
  /// 'admin' | 'member'
  role      String   @default("member")
  /// Encrypted WhatsApp number (for admin direct chat) + blind index.
  waEnc     String?
  waHash    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A scheduling group (a family, friend group, team, …). Jarvis hosts one
/// WhatsApp group per Group and keeps a single shared schedule.
model Group {
  id              String  @id @default(cuid())
  name            String
  /// 'group' for a normal user group, 'maintenance' for the single internal
  /// maintenance calendar (cron/pollers). Maintenance groups never link to a
  /// WhatsApp group, so their reminders never reach a chat.
  kind            String  @default("group")
  /// IANA time zone (e.g. "America/New_York"). One zone per group.
  timezone        String  @default("UTC")
  /// The WhatsApp group id once Jarvis has created/hosted the group.
  whatsappGroupId String? @unique
  /// Invite link members use to join the WhatsApp group.
  inviteLink      String?
  /// Secret token for the read-only iCal subscription feed.
  icalToken       String  @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       Member[]
  events        Event[]
  conversations Conversation[]
  /// Maintenance events that target this group.
  maintainedBy  Event[]        @relation("EventMaintains")

  @@index([whatsappGroupId])
}

/// A person who belongs to a Group. The same human in two groups is two Members.
model Member {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name  String?
  /// Encrypted WhatsApp number (AES-256-GCM, base64).
  waEnc  String? @db.Text
  /// Blind index (HMAC) of the WhatsApp number, for equality lookups.
  waHash String?
  /// Personal email address used when forwarding schedules to Jarvis.
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdEvents  Event[] @relation("EventCreator")
  assignedEvents Event[] @relation("EventAssignee")

  @@index([groupId])
  @@index([waHash])
  @@index([email])
}

/// A scheduled item: appointment, vacation, reminder, etc. Times stored in UTC.
model Event {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean   @default(false)
  location    String?
  /// appointment | vacation | reminder | other
  category    String?
  /// RFC 5545 RRULE value (without the "RRULE:" prefix) for recurring events,
  /// e.g. "FREQ=WEEKLY;BYDAY=TU". Null for one-off events. `startsAt` is the
  /// first occurrence / anchor.
  rrule       String?  @db.Text

  /// Where this event came from: whatsapp | email | web.
  source    String
  /// Provider message/email id, for de-duplication.
  sourceRef String?
  /// Original text the event was extracted from.
  rawText   String?  @db.Text

  createdById String?
  createdBy   Member? @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// The individual this event is for (null = whole group).
  assigneeId String?
  assignee   Member? @relation("EventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// For maintenance events: which group this task maintains (null = global).
  maintainsGroupId String?
  maintainsGroup   Group?  @relation("EventMaintains", fields: [maintainsGroupId], references: [id], onDelete: SetNull)

  /// When a reminder was last sent for this event.
  remindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, startsAt])
  @@index([source, sourceRef])
  @@index([assigneeId])
}

/// Per-group, per-channel conversation history used for agent context.
model Conversation {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// whatsapp | web
  channel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([groupId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role       String
  /// Display name of the member who sent a user message (group context).
  authorName String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([conversationId])
}
