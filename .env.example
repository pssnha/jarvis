# ---------- Core ----------
NODE_ENV=development
API_PORT=3000
PUBLIC_WEB_ORIGIN=http://localhost:5173

# ---------- Database (MySQL / MariaDB) ----------
# Local dev (docker-compose.dev.yml) defaults:
DATABASE_URL="mysql://jarvis:jarvis@localhost:3306/jarvis"

# ---------- Redis (BullMQ + Socket.IO) ----------
REDIS_URL=redis://localhost:6379

# ---------- Anthropic (Claude) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---------- WhatsApp (Meta Cloud API) ----------
# A token you invent; you enter the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# From your Meta App settings (used to verify inbound webhook signatures).
WHATSAPP_APP_SECRET=
# From WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0

# ---------- Docker Compose (prod) only ----------
# Used by docker-compose.yml to provision the MySQL container.
MYSQL_DATABASE=jarvis
MYSQL_USER=jarvis
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
