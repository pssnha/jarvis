{
  "name": "@jarvis/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jarvis/agent": "workspace:*",
    "@jarvis/db": "workspace:*",
    "@jarvis/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "imapflow": "^1.3.6",
    "ioredis": "^5.4.2",
    "mailparser": "^3.9.9",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
