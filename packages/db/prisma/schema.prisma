// Prisma schema for Jarvis — a shared scheduling assistant for small groups.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A person who can sign in to the web app (access control). Distinct from
/// Member, which is a participant in a group's schedule.
model AuthUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  googleSub String?  @unique
  /// 'admin' | 'member'
  role      String   @default("member")
  /// Encrypted WhatsApp number (for admin direct chat) + blind index.
  waEnc     String?
  waHash    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A scheduling group (a family, friend group, team, …). Jarvis hosts one
/// WhatsApp group per Group and keeps a single shared schedule.
model Group {
  id              String  @id @default(cuid())
  name            String
  /// 'group' for a normal user group, 'maintenance' for the single internal
  /// maintenance calendar (cron/pollers). Maintenance groups never link to a
  /// WhatsApp group, so their reminders never reach a chat.
  kind            String  @default("group")
  /// IANA time zone (e.g. "America/New_York"). One zone per group.
  timezone        String  @default("UTC")
  /// The WhatsApp group id once Jarvis has created/hosted the group.
  whatsappGroupId String? @unique
  /// Invite link members use to join the WhatsApp group.
  inviteLink      String?
  /// Secret token for the read-only iCal subscription feed.
  icalToken       String  @unique @default(cuid())

  /// Dedicated mailbox (IMAP) Jarvis polls for scheduling emails.
  emailAddress       String?  @unique
  /// Encrypted IMAP app-password (encryptValue); never returned by the API.
  emailEncCred       String?  @db.Text
  emailHost          String?
  emailPort          Int?
  emailEnabled       Boolean  @default(false)
  /// True once the initial full-mailbox scan has completed.
  emailFirstScanDone Boolean  @default(false)
  /// Highest processed IMAP UID (incremental polling after the first scan).
  emailLastUid       Int?
  emailLastPolledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       Member[]
  events        Event[]
  conversations Conversation[]
  vacations     Vacation[]
  proposals     EmailProposal[]
  /// Maintenance events that target this group.
  maintainedBy  Event[]        @relation("EventMaintains")

  @@index([whatsappGroupId])
}

/// A person who belongs to a Group. The same human in two groups is two Members.
model Member {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name  String?
  /// Encrypted WhatsApp number (AES-256-GCM, base64).
  waEnc  String? @db.Text
  /// Blind index (HMAC) of the WhatsApp number, for equality lookups.
  waHash String?
  /// Personal email address used when forwarding schedules to Jarvis.
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdEvents  Event[] @relation("EventCreator")
  assignedEvents Event[] @relation("EventAssignee")
  /// Trips this member is travelling on (implicit m2m -> _VacationTravelers).
  vacations      Vacation[] @relation("VacationTravelers")

  @@index([groupId])
  @@index([waHash])
  @@index([email])
}

/// A scheduled item: appointment, vacation, reminder, etc. Times stored in UTC.
model Event {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean   @default(false)
  location    String?
  /// "reminder" = simple, non-blocking notification (shows as a 30-min
  /// "available" slot, never causes conflicts). "event" = a hard block on the
  /// calendar (start+end, marked busy, warns on overlap with other events).
  kind        String    @default("reminder")
  /// For events: how many minutes before `startsAt` the reminder is sent.
  /// Null = at start time. Ignored for reminders (they fire at start).
  reminderLeadMinutes Int?
  /// appointment | vacation | reminder | other
  category    String?
  /// Optional hex color (e.g. "#2563eb"); falls back to the category color.
  color       String?
  /// RFC 5545 RRULE value (without the "RRULE:" prefix) for recurring events,
  /// e.g. "FREQ=WEEKLY;BYDAY=TU". Null for one-off events. `startsAt` is the
  /// first occurrence / anchor.
  rrule       String?  @db.Text

  /// Where this event came from: whatsapp | email | web.
  source    String
  /// Provider message/email id, for de-duplication.
  sourceRef String?
  /// Original text the event was extracted from.
  rawText   String?  @db.Text

  createdById String?
  createdBy   Member? @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// The individual this event is for (null = whole group).
  assigneeId String?
  assignee   Member? @relation("EventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// For maintenance events: which group this task maintains (null = global).
  maintainsGroupId String?
  maintainsGroup   Group?  @relation("EventMaintains", fields: [maintainsGroupId], references: [id], onDelete: SetNull)

  /// When a reminder was last sent for this event.
  remindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, startsAt])
  @@index([source, sourceRef])
  @@index([assigneeId])
}

/// A planned trip. Times are stored UTC and displayed in `timezone` (defaults
/// to the group's zone). Self-contained: does not create calendar Events.
model Vacation {
  id           String  @id @default(cuid())
  groupId      String
  group        Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title        String
  /// Comma-separated cities for the card subtitle, e.g. "Lisbon, Porto".
  destinations String?
  /// Trip span (all-day boundaries; stored UTC, rendered in `timezone`).
  startDate    DateTime
  endDate      DateTime
  /// IANA zone the whole trip displays in. Null = use group.timezone.
  timezone     String?
  description  String?  @db.Text
  /// Cover photo of the destination (resolved via LLM on create in prod).
  coverImageUrl String? @db.Text
  /// Group members on this trip (implicit m2m -> _VacationTravelers).
  travelers    Member[] @relation("VacationTravelers")
  items        VacationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, startDate])
}

/// One itinerary entry within a trip (activity, flight, hotel, …).
model VacationItem {
  id         String   @id @default(cuid())
  vacationId String
  vacation   Vacation @relation(fields: [vacationId], references: [id], onDelete: Cascade)
  /// activity | flight | hotel | transport | meal | note
  type       String   @default("activity")
  title      String
  /// flight=departure, hotel=check-in, activity/meal=start. UTC.
  startsAt   DateTime
  /// flight=arrival, hotel=check-out, activity end. UTC. Nullable.
  endsAt     DateTime?
  allDay     Boolean  @default(false)
  location   String?
  notes      String?  @db.Text
  /// Booking / PNR / reservation code.
  confirmation String?
  /// Airline / hotel chain / rental company.
  provider   String?
  /// Flight number / booking number.
  number     String?
  /// Departure airport / pickup point.
  fromLabel  String?
  /// Arrival airport / dropoff point.
  toLabel    String?
  /// IANA zones for transit items, so departure/arrival show in their own zones.
  fromTimezone String?
  toTimezone   String?
  /// Seat / room number / cabin.
  seat       String?
  phone      String?
  /// Free-text cost, e.g. "€420".
  cost       String?
  /// Optional hex color; falls back to a per-type default in the UI.
  color      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vacationId, startsAt])
}

/// A scheduling item detected in a polled email, awaiting group confirmation
/// over WhatsApp before it is created. `payload` is JSON used to recreate the
/// right entity (reminder/event/vacation) on confirmation.
model EmailProposal {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Short human ref shown in WhatsApp (e.g. "A1"), unique among pending ones.
  code       String
  /// reminder | event | vacation
  kind       String
  title      String
  /// Human-readable line shown in the WhatsApp confirmation digest.
  summary    String   @db.Text
  /// JSON: an EventDraft (+kind/lead) or a vacation { trip, item? }.
  payload    String   @db.Text
  fromEmail  String?
  subject    String?
  /// Email Message-ID, used to de-duplicate across polls.
  messageId  String?
  /// pending | confirmed | rejected
  status     String   @default("pending")
  /// When the proposal was posted to the WhatsApp group (null = not yet).
  notifiedAt DateTime?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([groupId, status])
  @@index([messageId])
}

/// Per-group, per-channel conversation history used for agent context.
model Conversation {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// whatsapp | web
  channel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([groupId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role       String
  /// Display name of the member who sent a user message (group context).
  authorName String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([conversationId])
}
