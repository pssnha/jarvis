{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis — web app + WhatsApp conversational interface (Claude-powered) with a background worker.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @jarvis/db generate",
    "db:migrate": "pnpm --filter @jarvis/db migrate",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
