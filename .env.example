# ---------- Core ----------
NODE_ENV=development
API_PORT=3000
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Default time zone for groups auto-created from WhatsApp (IANA, e.g. America/Los_Angeles).
DEFAULT_TIMEZONE=America/Los_Angeles

# ---------- Database (MySQL / MariaDB) ----------
# Local dev (docker-compose.dev.yml) defaults:
DATABASE_URL="mysql://jarvis:jarvis@localhost:3306/jarvis"

# ---------- Redis (BullMQ + Socket.IO) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth (Google OAuth + session) ----------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  <AUTH_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Strong random string for signing the session cookie (e.g. `openssl rand -hex 32`).
AUTH_SECRET=dev-insecure-secret-change-me
# Public origin the browser uses. Dev: http://localhost:5173 ; Prod: https://yourdomain
AUTH_BASE_URL=http://localhost:5173
# Seeded admin (authenticates via Google).
ADMIN_EMAIL=passanha@gmail.com

# ---------- LLM backend ----------
# Which assistant brain to use: "gemini" or "claude".
# If unset: Gemini when GEMINI_API_KEY is present, otherwise Claude.
LLM_PROVIDER=

# Anthropic (Claude) — used when LLM_PROVIDER=claude (or as fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- WhatsApp (Meta Cloud API) ----------
# A token you invent; you enter the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# From your Meta App settings (used to verify inbound webhook signatures).
WHATSAPP_APP_SECRET=
# From WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0

# ---------- Email intake (IMAP polling, used by the worker) ----------
# Jarvis's dedicated mailbox (e.g. a jarvis@yourdomain mailbox on Hostinger).
# Leave blank to disable email polling.
IMAP_HOST=
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASSWORD=

# ---------- Worker schedules (cron expressions) ----------
EMAIL_POLL_CRON=*/2 * * * *
REMINDER_CRON=* * * * *

# ---------- Docker Compose (prod) only ----------
# Used by docker-compose.yml to provision the MySQL container.
MYSQL_DATABASE=jarvis
MYSQL_USER=jarvis
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
